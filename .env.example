# 服务端默认配置；也可在页面设置中按会话输入兼容接口的凭据。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# 部分兼容接口不支持 JSON mode，可设为 false（仍会验证返回 JSON）。
OPENAI_JSON_MODE=true
# 自定义接口域名，以逗号分隔。服务端 OPENAI_BASE_URL 自动允许。
OPENAI_ALLOWED_HOSTS=
# 搜索必须配置一种；推荐 Tavily，或填写自建 SearXNG 完整 /search 地址。
TAVILY_API_KEY=
SEARXNG_URL=
# 可选：备用 HTTPS 搜索接口，以逗号分隔（最多两个）。
SEARXNG_FALLBACK_URLS=
# 可选：自托管 Laya 服务，默认不开启。
LAYA_BASE_URL=
LAYA_API_KEY=
