# 服务端默认配置；也可在页面设置中输入凭据，并保存在浏览器的加密 Cookie 中。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# 部分兼容接口不支持 JSON mode，可设为 false（仍会验证返回 JSON）。
OPENAI_JSON_MODE=true
# 自定义接口域名，以逗号分隔。服务端 OPENAI_BASE_URL 自动允许。
OPENAI_ALLOWED_HOSTS=
# 搜索必须配置一种；推荐 Tavily，或填写自建 SearXNG 完整 /search 地址。
TAVILY_API_KEY=
SEARXNG_URL=
# 可选：备用 HTTPS 搜索接口，以逗号分隔（最多两个）。
SEARXNG_FALLBACK_URLS=
# 可选：自托管 Laya 服务，默认不开启。
LAYA_BASE_URL=
LAYA_API_KEY=

# Cookie AES-256-GCM 加密密钥：随机32字节的base64url字符串，保持稳定，不提交实际值。
SETTINGS_COOKIE_SECRET=
# 可选：Google Search Console 的 HTML 标记验证值（仅 content 的值，不含整个 meta 标签）。
GOOGLE_SITE_VERIFICATION=
